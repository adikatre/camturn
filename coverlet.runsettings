<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage for product code only; the simulator and test helpers are test infrastructure (and their per-pixel
     loops are very slow when instrumented). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[CamTurn.Simulator]*,[CamTurn.Testing]*,[camturn-sim]*,[CamTurn.*.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
