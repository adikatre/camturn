<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CamTurn.Platform.Windows</RootNamespace>
    <Description>Windows implementations: WinRT sensors and camera capture, ACL-protected frame pipe, virtual camera registration, autostart, session events, diagnostics.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CamTurn.Core\CamTurn.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
</Project>
