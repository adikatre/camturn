<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CamTurn</AssemblyName>
    <RootNamespace>CamTurn.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\camturn.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <StartupObject>CamTurn.App.Program</StartupObject>
    <!-- WinForms is only used for the tray NotifyIcon; avoid its implicit usings clashing with WPF. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- ThemeMode (Fluent light/dark that follows Windows) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Program.Main owns startup (CLI commands, single instance), so App.xaml is a Page, not the ApplicationDefinition. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CamTurn.Core\CamTurn.Core.csproj" />
    <ProjectReference Include="..\CamTurn.Platform.Windows\CamTurn.Platform.Windows.csproj" />
    <ProjectReference Include="..\CamTurn.Simulator\CamTurn.Simulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icons\tray-idle.ico" LogicalName="tray-idle.ico" />
    <EmbeddedResource Include="..\..\assets\icons\tray-streaming.ico" LogicalName="tray-streaming.ico" />
    <EmbeddedResource Include="..\..\assets\icons\tray-error.ico" LogicalName="tray-error.ico" />
    <Resource Include="..\..\assets\icons\camturn.ico" Link="camturn.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Device profiles for the developer-only simulate-device option. -->
    <None Include="..\..\sim\devices\*.json" Link="sim\devices\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
