<Window x:Class="CamTurn.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CamTurn settings"
        Icon="/camturn.ico"
        Width="1040" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="5*" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="4*" />
    </Grid.ColumnDefinitions>

    <!-- Left: live preview of exactly what apps receive -->
    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="Live preview (what apps see)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
      <Border DockPanel.Dock="Top" Background="Black" CornerRadius="6" ClipToBounds="True">
        <Grid>
          <Image x:Name="Preview" Stretch="Uniform" MinHeight="200"
                 AutomationProperties.Name="Live preview of the CamTurn Camera output" />
          <TextBlock x:Name="PreviewPlaceholder" Text="Starting the camera for the preview…" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" />
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="4" Background="#CC000000">
            <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding OrientationBadge}"
                       AutomationProperties.Name="Detected orientation" />
          </Border>
        </Grid>
      </Border>
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,8,0,0"
                 Text="The camera light is on while this window is open because the preview uses the camera. It turns off a few seconds after you close the window, unless an app is using CamTurn Camera." />

      <TextBlock DockPanel.Dock="Top" Text="Status" Style="{StaticResource SectionHeader}" />
      <Grid DockPanel.Dock="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="State" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PipelineText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="Virtual camera" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VirtualCameraText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Text="Media source" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MediaSourceText}" />
        <TextBlock Grid.Row="3" Text="Physical camera" />
        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CameraText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="4" Text="Apps connected" />
        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ConsumerText}" />
        <TextBlock Grid.Row="5" Text="Frame rate" />
        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding FpsText}" />
        <TextBlock Grid.Row="6" Text="Rotation applied" />
        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding RotationText}" />
        <TextBlock Grid.Row="7" Text="Sensor" />
        <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding SensorText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="8" Text="Last problem" />
        <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding ErrorText}" TextWrapping="Wrap" />
      </Grid>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="{Binding CopyLabel}" Command="{Binding CopyDiagnosticsCommand}" Padding="12,6"
                AutomationProperties.HelpText="Copies a redacted diagnostics report for bug reports" />
        <Button Content="Register virtual camera (administrator)" Command="{Binding RepairCommand}" Padding="12,6" Margin="8,0,0,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding RepairNeeded}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </StackPanel>
      <Grid />
    </DockPanel>

    <!-- Right: settings -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <TextBlock Text="Camera" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
        <Label Content="_Physical camera" Target="{Binding ElementName=CameraBox}" Padding="0,0,0,4" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCamerasCommand}" Margin="8,0,0,0" Padding="10,4" />
          <ComboBox x:Name="CameraBox" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" />
        </DockPanel>
        <Label Content="_Output size" Target="{Binding ElementName=ResolutionBox}" Padding="0,8,0,4" />
        <ComboBox x:Name="ResolutionBox" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" />
        <Label Content="_Frame rate" Target="{Binding ElementName=FpsBox}" Padding="0,8,0,4" />
        <ComboBox x:Name="FpsBox" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FrameRate}" />
        <TextBlock Style="{StaticResource Hint}" Text="Apps choose 1280 × 720 or 1920 × 1080 themselves; this sets the preview and default." />

        <TextBlock Text="Rotation" Style="{StaticResource SectionHeader}" />
        <RadioButton GroupName="Rotation" Content="_Automatic: follow how the device is held" IsChecked="{Binding AutoRotation}" />
        <CheckBox Content="Advanced: follow the Windows display rotation instead of the sensor" Margin="24,6,0,0"
                  IsChecked="{Binding FollowDisplay}" IsEnabled="{Binding AutoRotation}" />
        <RadioButton GroupName="Rotation" Content="_Manual" Margin="0,8,0,0" IsChecked="{Binding ManualRotationEnabled, Mode=OneWay}"
                     Checked="OnManualChecked" />
        <ComboBox Margin="24,6,0,0" ItemsSource="{Binding ManualRotations}" SelectedItem="{Binding ManualRotation}"
                  IsEnabled="{Binding ManualRotationEnabled}" AutomationProperties.Name="Manual rotation angle" />

        <TextBlock Text="Orientation mapping" Style="{StaticResource SectionHeader}" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="How each measured device position is corrected. If the picture turns the wrong way when you rotate the device, use Flip direction." />
        <TextBlock Text="{Binding Mapping0}" />
        <TextBlock Text="{Binding Mapping90}" />
        <TextBlock Text="{Binding Mapping180}" />
        <TextBlock Text="{Binding Mapping270}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="This looks wrong: _flip direction" Command="{Binding FlipDirectionCommand}" Padding="12,6" />
          <Button Content="_Reset" Command="{Binding ResetMappingCommand}" Padding="12,6" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock Text="Picture" Style="{StaticResource SectionHeader}" />
        <CheckBox Content="_Mirror horizontally" IsChecked="{Binding Mirror}" />
        <CheckBox Content="In portrait, fill the frame (crop) instead of fitting it (black bars)" Margin="0,6,0,0" IsChecked="{Binding PortraitFill}" />

        <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}" />
        <CheckBox Content="Start with _Windows" IsChecked="{Binding StartWithWindows}" />
        <CheckBox Content="Start minimized to the tray" Margin="0,6,0,0" IsChecked="{Binding StartMinimized}" />
        <CheckBox Content="Release the camera when the PC is locked or asleep" Margin="0,6,0,0" IsChecked="{Binding ReleaseOnLock}" />
        <Label Content="When to use the _camera" Target="{Binding ElementName=RunModeBox}" Padding="0,10,0,4" />
        <ComboBox x:Name="RunModeBox" ItemsSource="{Binding RunModes}" SelectedItem="{Binding RunModeChoice}" />

        <TextBlock Style="{StaticResource Hint}" Margin="0,20,0,0"
                   Text="CamTurn works offline: no network access, no telemetry, and video is never saved or sent anywhere. Closing this window keeps CamTurn running in the notification area." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
